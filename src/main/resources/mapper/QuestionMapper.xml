<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.QuestionMapper">

    <resultMap id="QuestionResultMap" type="org.example.Question">
        <id property="id" column="id"/>
        <result property="question_id" column="question_id"/>
        <result property="title" column="title"/>
        <result property="category_id" column="category_id"/>
        <result property="difficulty" column="difficulty"/>
        <result property="year" column="year"/>
        <result property="source" column="source"/>
        <result property="status" column="status"/>

        <result property="correct_answer" column="correct_answer"/>
        <result property="answer_analysis" column="answer_analysis"/>
        <result property="tips" column="tips"/>
        <result property="selected_answer" column="selected_answer"/>

        <result property="question_content" column="question_content"
                typeHandler="org.example.handler.JsonTypeHandler"
                javaType="org.example.QuestionContent"/>

        <result property="has_image" column="has_image"/>
        <result property="image_url" column="image_url"/>
        <result property="has_material" column="has_material"/>
        <result property="content_text" column="content_text"/>
        <result property="material_id" column="material_id"/>
    </resultMap>

    <select id="findAll" resultMap="QuestionResultMap">
        SELECT * FROM logical_judgment
    </select>

    <select id="findById" resultMap="QuestionResultMap">
        SELECT * FROM logical_judgment WHERE question_id = CAST(#{questionId} AS VARCHAR)
    </select>

    <insert id="insert">
        INSERT INTO logical_judgment
        (title, category_id, difficulty, year, source, status, question_content, correct_answer, answer_analysis, tips)
        VALUES
        (#{title}, #{category_id}, #{difficulty}, #{year}, #{source}, #{status},
        #{question_content, typeHandler=org.example.handler.JsonTypeHandler},
        #{correct_answer}, #{answer_analysis}, #{tips})
    </insert>

    <delete id="deleteById">
        DELETE FROM logical_judgment WHERE question_id = #{questionId}
    </delete>

    <update id="update">
        UPDATE logical_judgment SET
        title = #{title},
        category_id = #{category_id},
        difficulty = #{difficulty},
        year = #{year},
        source = #{source},
        status = #{status},
        question_content = #{question_content, typeHandler=org.example.handler.JsonTypeHandler},
        correct_answer = #{correct_answer},
        answer_analysis = #{answer_analysis},
        tips = #{tips}
        WHERE question_id = #{question_id}
    </update>

    <select id="listLogical" resultMap="QuestionResultMap">
        SELECT * FROM logical_judgment
    </select>
    <select id="listCommonSense" resultMap="QuestionResultMap">
        SELECT * FROM common_sense_judgment
    </select>
    <select id="listSpeech" resultMap="QuestionResultMap">
        SELECT * FROM language_understanding
    </select>
    <select id="listQuantitative" resultMap="QuestionResultMap">
        SELECT * FROM quantity_relation
    </select>
    <select id="listDataAnalysis" resultMap="QuestionResultMap">
        SELECT * FROM material_analysis
    </select>
    <select id="listPoliticalTheory" resultMap="QuestionResultMap">
        SELECT * FROM political_theory
    </select>

    <select id="findAllFromTotal" resultMap="QuestionResultMap">
        SELECT * FROM questions_total
    </select>

    <select id="findBySpeechId" resultMap="QuestionResultMap">
        SELECT * FROM language_understanding WHERE question_id = CAST(#{questionId} AS VARCHAR)
    </select>

    <select id="findByQuantitativeId" resultMap="QuestionResultMap">
        SELECT * FROM quantity_relation WHERE question_id = CAST(#{questionId} AS VARCHAR)
    </select>

    <select id="findByCommonSenseId" resultMap="QuestionResultMap">
        SELECT * FROM common_sense_judgment WHERE question_id = CAST(#{questionId} AS VARCHAR)
    </select>

    <select id="findByDataAnalysisId" resultMap="QuestionResultMap">
        SELECT * FROM material_analysis WHERE question_id = CAST(#{questionId} AS VARCHAR)
    </select>

    <select id="findByPoliticalId" resultMap="QuestionResultMap">
        SELECT * FROM political_theory WHERE question_id = CAST(#{questionId} AS VARCHAR)
    </select>

    <select id="findByTotalId" resultMap="QuestionResultMap">
        SELECT * FROM questions_total WHERE question_id = CAST(#{questionId} AS VARCHAR) LIMIT 1
    </select>

</mapper>